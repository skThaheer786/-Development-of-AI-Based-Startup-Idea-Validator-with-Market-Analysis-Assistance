# Flask Environment
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# Groq LLM API key (free tier available: https://console.groq.com)
GROQ_API_KEY=
# NOTE: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768 and
# gemma2-9b-it have been shut down by Groq. Use one of the models below.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Tavily web search (optional, free tier = 1000 credits/month: https://tavily.com)
# Without a key the app uses free DuckDuckGo search + Wikipedia instead.
TAVILY_API_KEY=

# Research limits (each idea uses roughly 15-24 searches)
MAX_SEARCHES_PER_IDEA=24
HTTP_TIMEOUT=8
LLM_TIMEOUT=90
# standard = full depth (about 2 min) | quick = fast model, fewer searches/items, no advisor brief (aim: about 1 min)
ANALYSIS_MODE=standard
# Groq free tier = about 8000 tokens/minute and 200000 tokens/day PER MODEL. The app paces requests to stay inside this
# and spreads calls over the main and fallback model. Set 0 on a paid Groq plan to switch pacing off.
GROQ_TPM_LIMIT=8000
# Seconds to wait before an agent that failed transiently (rate limit, timeout, bad JSON) is retried once automatically
AGENT_RETRY_PAUSE=10
# Simultaneous Groq calls. 2 is safe on the free tier; raise to 3-4 on a paid plan for more speed.
LLM_CONCURRENCY=2

# Database path (defaults to startup_validator.db next to app.py)
DATABASE_PATH=startup_validator.db

# Server configuration
PORT=5000
HOST=127.0.0.1
